{
  "name": "web-ui-color-palette",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/ui-ui-color-palette"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist/server",
    "start": "node --import tsx/esm server.ts",
    "preview": "NODE_ENV=production node --import tsx/esm server.ts",
    "typecheck": "npx tsc --noEmit",
    "lint": "npx eslint ./src --fix --ext .ts,.tsx",
    "format": "npx prettier './src' --write",
    "typecheck:worker": "tsc -p tsconfig.worker.json",
    "dev:worker": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "preact": "^10.6.4",
    "preact-iso": "^2.9.1",
    "ui-ui-color-palette": "*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260915.1",
    "@preact/preset-vite": "^2.10.1",
    "@types/express": "^5.0.3",
    "@types/node": "latest",
    "express": "^5.1.0",
    "tsx": "^4.20.3",
    "typescript": "latest",
    "vite": "^6.3.5",
    "wrangler": "^4.132.0"
  }
}
